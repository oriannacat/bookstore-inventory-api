# Selects the settings module: config.settings.development (default via manage.py)
# or config.settings.production (default via wsgi.py / gunicorn).
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*

# Leave DATABASE_URL unset to use local SQLite (only allowed in development).
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# Only relevant for config.settings.production. A local docker-compose Postgres
# has no SSL, so both are disabled there (see docker-compose.yml).
DB_SSL_REQUIRE=True
SECURE_SSL_REDIRECT=True

# Used by docker-compose to provision the local Postgres container
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore

# Comma-separated list of origins allowed to call the API in production
# (ignored in development, where CORS is fully open).
CORS_ALLOWED_ORIGINS=

# Price calculation
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
LOCAL_CURRENCY=EUR
DEFAULT_EXCHANGE_RATE=0.85
PROFIT_MARGIN_PERCENTAGE=40
EXCHANGE_RATE_CACHE_TTL_SECONDS=300

# Optional: if set, POST/PUT/PATCH/DELETE on /books/ require this value in the
# "X-API-Key" header. Leave empty to keep write access open.
API_KEY=
